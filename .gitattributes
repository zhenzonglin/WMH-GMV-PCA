* text=auto
*.sh text eol=lf
*.py text eol=lf
*.R text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
# Preserve the reviewed bytes of distributed atlas resources and their checksums.
resources/atlases/** -text
resources/atlas_sources/** -text
resources/licenses/** -text
resources/atlases/*.tsv whitespace=cr-at-eol
resources/atlas_sources/** whitespace=-blank-at-eof,cr-at-eol
resources/licenses/** whitespace=-blank-at-eof,cr-at-eol
*.png -text
*.nii.gz -text
